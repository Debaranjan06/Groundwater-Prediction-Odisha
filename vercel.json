{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "backend/{app,ml,models_store}/**",
      "excludeFiles": "{.venv/**,frontend/**,node_modules/**,backend/models_store/*.joblib,backend/models_store/lstm.keras,backend/data/**,backend/scripts/**,**/__pycache__/**,**/*.pyc,**/tests/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
